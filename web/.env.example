# ─── IACTS Technocollege CME 2026 — environment ───────────────────────────
# Copy to .env.local and fill in. NEVER commit .env.local.

# Database (MongoDB Atlas)
MONGODB_URI=

# Auth (generate: openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email / SMTP (registration + abstract notifications)
#
# GOTCHA: Next.js expands $VAR references inside .env files, so a password
# containing "$" must be escaped here as "\$" (e.g. Pa55word@\$2026).
# Vercel dashboard variables are NOT expanded — paste the password RAW there,
# with no backslash. Getting this wrong shows up as a 535 auth failure even
# though the password is correct.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_HOST=
EMAIL_USER=
EMAIL_PASS=
ADMIN_ALERT_EMAIL=

# Payments — Razorpay is OFF for now (bank transfer is primary).
# Fill these and flip conferenceConfig.payment.methods.razorpay to true.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# File uploads (abstracts) — Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Optional
CRON_API_KEY=

# Seeding — required by `pnpm seed`. Seeding refuses to run without these
# (no default admin password is ever created).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_PHONE=
# Optional reviewer account
SEED_REVIEWER_EMAIL=
SEED_REVIEWER_PASSWORD=
SEED_REVIEWER_PHONE=

# Optional: faculty phone numbers (comma-separated) that get the Early Bird
# member rate regardless of date. Personal data — keep out of the repo.
EARLY_BIRD_FACULTY_PHONES=
